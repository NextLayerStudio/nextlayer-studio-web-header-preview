# Resend — https://resend.com/api-keys
NLS_NEW_RESEND_API_KEY=re_xxxxxxxx

# Verified sender in Resend (e.g. "NextLayer Studio <team@nextlayer.studio>")
RESEND_FROM_EMAIL="NextLayer Studio <onboarding@resend.dev>"

# Inbox for contact form submissions
CONTACT_TO_EMAIL=team@nextlayer.studio

# Vercel Blob — Storage → your store → Tokens (read-write)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
# Optional; Vercel dashboard store id (store_...)
BLOB_STORE_ID=store_xxxxxxxx

# Public CDN origin from scripts/sync-blob-media.mjs (no trailing slash)
NEXT_PUBLIC_BLOB_BASE_URL=https://xxxxxxxx.public.blob.vercel-storage.com
